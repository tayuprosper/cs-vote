ADMIN_UBNUMBER=
ADMIN_PASSWORD=

# Only needed locally; Railway assigns PORT automatically.
API_PORT=4100

# Comma-separated list of allowed frontend origins (e.g. your Vercel URL).
# Leave unset to allow any origin.
ALLOWED_ORIGINS=

# Only needed on Railway if you attach a volume for the vote database;
# point this at the volume's mount path so db.json survives redeploys.
DATA_DIR=
